# Copiar a .env y reemplazar TODOS los valores. Estos son de ejemplo y no son seguros.
# Las URL apuntan a localhost para correr la API fuera de Docker. Dentro de docker compose,
# el servicio api las reemplaza por los hosts postgres, redis y mockoon.

# PostgreSQL
POSTGRES_USER=reservalab
POSTGRES_PASSWORD=cambiar_esta_clave_falsa
POSTGRES_DB=reservalab
# Puerto del host; 5433 para no chocar con un PostgreSQL instalado localmente en 5432
POSTGRES_PORT=5433
DATABASE_URL=postgresql://reservalab:cambiar_esta_clave_falsa@localhost:5433/reservalab?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT del access token (generar un valor aleatorio largo). El refresh token es opaco: no se firma.
JWT_ACCESS_SECRET=secreto_de_acceso_falso_cambiar
# Vida de los tokens: access token en segundos (15 min), refresh token en días
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Servicio de notificaciones (Mockoon)
NOTIFICATIONS_PORT=3001
NOTIFICATIONS_URL=http://localhost:3001
# Tiempo máximo de espera de cada notificación; si se excede se registra el error y la reserva sigue
NOTIFICATIONS_TIMEOUT_MS=2000
# Token del admin API de Mockoon; las pruebas de pnpm test:integration:mockoon lo usan para leer los avisos recibidos
MOCKOON_ADMIN_API_TOKEN=token_admin_mockoon_falso

# API (puerto del host; dentro del contenedor siempre escucha en 3000)
API_PORT=3000

# Solicitudes por minuto permitidas a cada API key (ventana fija de 1 minuto en Redis)
API_KEY_RATE_LIMIT_PER_MINUTE=60

# Segundos que dura en Redis la caché de /spaces, disponibilidad y /now
CACHE_TTL_SECONDS=60

# Contraseña de los usuarios creados por el seed (solo desarrollo). El seed corre solo al arrancar la
# API en Docker y crea, si no existen, estas cuentas de ejemplo, todas con esta contraseña:
#   admin@reservalab.test       (ADMIN)
#   docente@reservalab.test     (DOCENTE)
#   estudiante@reservalab.test  (ESTUDIANTE)
# y tres espacios: Laboratorio de Computación 1, Laboratorio de Redes y Salón 201.
SEED_USER_PASSWORD=clave_de_prueba_falsa

# Ventana de operación de los espacios (horas enteras, hora de Guatemala UTC-6)
OPENING_HOUR=7
CLOSING_HOUR=21

# Web (nginx en el contenedor web; reenvía /api a la API)
WEB_PORT=8080
# API key de la pantalla informativa (GET /now). Se incrusta en el JavaScript de la web al construirla,
# así que es pública: el seed la registra con SOLO el permiso read:now. Este valor de demo funciona tal
# cual para probar en local; fuera de la demo, generar una propia con:
#   node -e "console.log('rl_live_' + require('crypto').randomBytes(32).toString('base64url'))"
VITE_INFO_API_KEY=rl_live_demo_publica_solo_lectura_now_no_produccion

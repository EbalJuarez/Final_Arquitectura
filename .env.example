# Copiar a .env y reemplazar TODOS los valores. Estos son de ejemplo y no son seguros.

# PostgreSQL
POSTGRES_USER=reservalab
POSTGRES_PASSWORD=cambiar_esta_clave_falsa
POSTGRES_DB=reservalab
# Puerto del host; 5433 para no chocar con un PostgreSQL instalado localmente en 5432
POSTGRES_PORT=5433
DATABASE_URL=postgresql://reservalab:cambiar_esta_clave_falsa@localhost:5433/reservalab?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT (generar valores aleatorios largos, distintos entre sí)
JWT_ACCESS_SECRET=secreto_de_acceso_falso_cambiar
JWT_REFRESH_SECRET=secreto_de_refresco_falso_cambiar

# Servicio de notificaciones (Mockoon)
NOTIFICATIONS_PORT=3001
NOTIFICATIONS_URL=http://localhost:3001

# API
API_PORT=3000

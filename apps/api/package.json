{
  "name": "@reservalab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "prisma": "node --env-file=../../.env ./node_modules/prisma/build/index.js",
    "db:generate": "pnpm prisma generate",
    "db:migrate": "pnpm prisma migrate dev",
    "db:deploy": "pnpm prisma migrate deploy",
    "db:seed": "pnpm prisma db seed"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "@reservalab/shared": "workspace:*",
    "express": "5.3.0",
    "redis": "5.12.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "prisma": "6.19.3",
    "tsx": "4.23.15"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
